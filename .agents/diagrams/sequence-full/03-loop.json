  "cards": [
    {
      "dot": "cyan",
      "title": "Все инструменты — порядок выбирает LLM",
      "items": [
        "get_claim — получить заявку и документы",
        "get_policy — получить полис клиента",
        "get_claim_history — получить историю обращений",
        "record_decision — сохранить решение, сумму и обоснование",
